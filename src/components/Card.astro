---
interface Props {
  tag?: string;
  title?: string;
  body?: string;
  ar?: string;
  img?: string;
  index?: number;
  span?: string;
  dark?: boolean;
}
const { tag = '', title = '', body = '', ar = '', img = '', index = 0, span = '', dark = true } = Astro.props;
---

<article
  class:list={[
    'tilt group relative overflow-hidden rounded-3xl border reveal',
    span,
    dark ? 'border-white/10 bg-ink2' : 'border-[#100f0d]/10 bg-white/60',
  ]}
  data-tilt
  style={`--d:${100 + index * 110}ms`}
>
  <div class="img-wrap relative h-52 overflow-hidden sm:h-60">
    <img
      src={img}
      alt={title}
      width="300"
      height="225"
      loading="lazy"
      decoding="async"
      class="img-kenburns h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/25 to-transparent opacity-90"></div>
    <span class="absolute left-4 top-4 rounded-full bg-amber px-3 py-1 font-mono2 text-[10px] uppercase tracking-[.18em] text-ink">
      {tag}
    </span>
  </div>

  <div class="tilt-inner relative p-6">
    <div class="flex items-start justify-between gap-4">
      <h3 class="font-display text-xl font-bold sm:text-2xl">{title}</h3>
      <span class="font-mono2 text-[11px] text-bone/35">0{index + 1}</span>
    </div>
    <p class="mt-3 text-[14px] leading-relaxed text-bone/55">{body}</p>
    {ar && <p class="font-ar mt-3 text-[13px] leading-loose text-amber/70" dir="rtl">{ar}</p>}
    <div class="mt-5 h-px w-full bg-gradient-to-r from-amber/60 via-white/10 to-transparent"></div>
  </div>
</article>