<div class="mt-12 grid auto-rows-[minmax(150px,auto)] grid-cols-2 gap-3 sm:gap-4 md:grid-cols-4 md:auto-rows-[minmax(180px,auto)]">
  {
    posts.map((p, i) => (
      <a
        href="https://www.instagram.com/nicolacafeerbil/"
        target="_blank"
        rel="noopener noreferrer"
        class:list={['tilt group relative block overflow-hidden rounded-2xl bg-cream reveal', p.span]}
        data-tilt
        style={`--d:${(i % 5) * 90}ms`}
        aria-label={`Instagram post: ${p.caption.slice(0, 60)}`}
      >
        <img
          src={p.image_url}
          alt={p.caption}
          width="640"
          height="640"
          loading="lazy"
          decoding="async"
          class="img-kenburns h-full min-h-[150px] w-full object-cover md:min-h-[180px]"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/10 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100 group-focus-visible:opacity-100" />

        <div class="tilt-inner pointer-events-none absolute inset-x-0 bottom-0 translate-y-3 p-4 opacity-0 transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100">
          <div class="glass rounded-xl p-3">
            <p class="line-clamp-3 text-[12.5px] leading-snug text-bone">{p.caption}</p>
            <div class="mt-2.5 flex items-center justify-between font-mono2 text-[10px] uppercase tracking-[.16em] text-bone/75">
              <span class="inline-flex items-center gap-1.5">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 21s-7.5-4.7-9.6-9A5.4 5.4 0 0 1 12 6.2 5.4 5.4 0 0 1 21.6 12c-2.1 4.3-9.6 9-9.6 9Z" />
                </svg>
                {p.likes > 0 ? p.likes : 'like'}
              </span>
              <span>View ↗</span>
            </div>
          </div>
        </div>

        <span class="absolute right-3 top-3 rounded-full bg-ink/70 px-2.5 py-1 font-mono2 text-[9px] tracking-[.2em] text-bone opacity-0 backdrop-blur transition-opacity duration-300 group-hover:opacity-100">
          0{i + 1}
        </span>
      </a>
    ))
  }
</div>