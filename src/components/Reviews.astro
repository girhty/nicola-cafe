---
const quotes = [
  {
    text: 'Elegance in the place… and a taste you’ll never forget.',
    ar: 'فخامة بالمكان… وطعم ما بينتسى',
    meta: 'Instagram caption · @nicolacafeerbil',
  },
  {
    text: 'Portuguese details… and an unforgettable taste.',
    ar: 'تفاصيل برتغالية… ومذاق ما بينتسى',
    meta: 'Instagram caption · @nicolacafeerbil',
  },
  {
    text: 'Your journey is better… when Nicola is with you.',
    ar: 'مشوارك أحلى… لما يكون معك Nicola',
    meta: 'Instagram caption · @nicolacafeerbil',
  },
];
---

<section id="reviews" data-surface="dark" class="relative overflow-hidden bg-ink py-20 sm:py-28" aria-labelledby="reviews-title">
  <div class="pointer-events-none absolute -left-32 top-10 h-72 w-72 rounded-full bg-amber/15 blur-[110px]" aria-hidden="true"></div>

  <div class="mx-auto max-w-shell px-5 sm:px-8">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <p class="eyebrow reveal text-bone/50">05 — Reputation</p>
        <h2 id="reviews-title" class="mt-5 text-4xl font-extrabold leading-[.95] sm:text-5xl">
          <span class="line-mask"><span>Rated by</span></span>
          <span class="line-mask" style="--d:110ms"><span class="text-amber">our guests.</span></span>
        </h2>

        <div class="reveal mt-8 rounded-3xl border border-white/10 bg-ink2 p-6" style="--d:160ms">
          <div class="flex items-end gap-3">
            <span class="font-display text-6xl font-extrabold leading-none text-amber">
              <span data-count="4.6" data-decimals="1">0.0</span>
            </span>
            <span class="pb-1 font-mono2 text-xs uppercase tracking-[.2em] text-bone/45">/ 5.0</span>
          </div>
          <div class="mt-4 flex items-center gap-1 text-amber" aria-hidden="true">
            {
              [1, 2, 3, 4, 5].map((s) => (
                <svg width="18" height="18" viewBox="0 0 24 24" fill={s <= 4 ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="1.4">
                  <path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9L12 3Z" />
                </svg>
              ))
            }
          </div>
          <p class="mt-3 text-sm text-bone/55">Google rating for Nicola Cafe · Erbil, Erbil Governorate</p>
          <a
            href="https://www.google.com/maps/search/?api=1&query=Nicola+Cafe+Erbil"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline mt-5 w-full"
          >
            See on Google Maps <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="lg:col-span-8">
        <div class="grid gap-5 sm:grid-cols-3">
          {
            quotes.map((q, i) => (
              <figure
                class="tilt flex h-full flex-col justify-between rounded-3xl border border-white/10 bg-gradient-to-b from-ink2 to-ink p-6 reveal"
                data-tilt
                style={`--d:${120 + i * 130}ms`}
              >
                <div>
                  <span class="font-script text-5xl leading-none text-amber/70" aria-hidden="true">“</span>
                  <blockquote class="mt-2 text-[15px] leading-relaxed text-bone/85">{q.text}</blockquote>
                  <p class="font-ar mt-3 text-[13px] leading-loose text-bone/45" dir="rtl">
                    {q.ar}
                  </p>
                </div>
                <figcaption class="mt-6 border-t border-white/10 pt-4 font-mono2 text-[10px] uppercase tracking-[.18em] text-bone/40">
                  {q.meta}
                </figcaption>
              </figure>
            ))
          }
        </div>

        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          {
            [
              ['Quality of coffee', 'Portuguese method, roasted weekly'],
              ['Atmosphere', 'Low light, deep seats, quiet corners'],
              ['Service', 'Open 16 hours, every single day'],
            ].map(([t, b], i) => (
              <div class="rounded-2xl border border-white/10 bg-white/[.03] p-5 reveal" style={`--d:${200 + i * 110}ms`}>
                <p class="font-mono2 text-[10px] uppercase tracking-[.24em] text-amber">Strength</p>
                <p class="font-display mt-2 text-base font-bold">{t}</p>
                <p class="mt-1 text-[13px] text-bone/50">{b}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>