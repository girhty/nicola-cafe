---
const profile =
  'https://scontent-ams2-1.cdninstagram.com/v/t51.82787-19/519728600_17846163981527572_2154922724636557149_n.jpg?stp=dst-jpg_s150x150_tt6&_nc_cat=102&ccb=7-5&_nc_sid=f7ccc5&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLnd3dy4xMDgwLkMzIn0%3D&_nc_ohc=rE6XguNLvBMQ7kNvwHMPDPj&_nc_oc=AdqQkh4Y8DolgqE6LfRhCiXXq8uDIWFnOKaFHVruvQt530-cmo8xqoCAkeCZYswIrkg&_nc_zt=24&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=UWQl3q5T9w751lcsvXxbqw&_nc_ss=7ba8c&oh=00_AQIaPuOk6SosRjkLj-xf8UA4iYIm_-ubjrPy2l8TqmE0uw&oe=6ABDB80B';
---

<section
  id="top"
  data-surface="dark"
  class="relative isolate min-h-[100svh] overflow-hidden bg-ink pt-24 sm:pt-28"
  aria-labelledby="hero-title"
>
  <!-- ambient base -->
  <div
    class="pointer-events-none absolute inset-0 -z-20 bg-[radial-gradient(120%_80%_at_70%_20%,rgba(224,162,74,.16),transparent_60%),radial-gradient(90%_70%_at_10%_90%,rgba(201,120,74,.14),transparent_65%)]"
    aria-hidden="true"
  ></div>

  <!-- procedural WebGL hero scene -->
  <canvas id="hero-canvas" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full"></canvas>

  <div class="relative mx-auto grid max-w-shell items-center gap-12 px-5 pb-24 pt-10 sm:px-8 lg:min-h-[calc(100svh-9rem)] lg:grid-cols-12">
    <!-- copy -->
    <div class="lg:col-span-7">
      <p class="eyebrow reveal text-amber">Est. 1779 · Erbil, Iraq</p>

      <h1 id="hero-title" class="mt-7 text-[15vw] font-extrabold leading-[.82] sm:text-8xl lg:text-[7.5rem]">
        <span class="line-mask"><span>Nicola</span></span>
        <span class="line-mask" style="--d:120ms"><span class="text-amber">Cafe</span></span>
      </h1>

      <p class="font-ar mt-3 text-2xl text-bone/70 sm:text-3xl reveal" style="--d:240ms" dir="rtl">کافێ نیکۆڵا</p>

      <p class="font-script mt-6 max-w-xl text-3xl leading-tight text-bone/85 sm:text-4xl reveal" style="--d:300ms">
        same flavor, but a new way of drinking
      </p>

      <p class="mt-6 max-w-lg text-[15px] leading-relaxed text-bone/55 reveal" style="--d:380ms">
        Premium coffee, sweet treats and unmatched vibes — poured daily from 8:30 in the morning until after
        midnight, in the heart of Erbil.
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3 reveal" style="--d:450ms">
        <a href="tel:+9647500071779" class="btn btn-solid">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.46.57 3.6a1 1 0 0 1-.25 1l-2.22 2.2Z" fill="currentColor" />
          </svg>
          0750 007 1779
        </a>
        <a
          href="https://www.google.com/maps/search/?api=1&query=Nicola+Cafe+Erbil"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline"
        >
          Get directions <span aria-hidden="true">↗</span>
        </a>
        <span class="inline-flex items-center gap-2 rounded-full border border-white/15 px-4 py-2.5">
          <span class="text-amber" aria-hidden="true">★</span>
          <span class="font-mono2 text-[12px] tracking-wide">
            <span data-count="4.6" data-decimals="1">0.0</span> / 5 · Google
          </span>
        </span>
      </div>
    </div>

    <!-- floating brand badge + live status -->
    <div class="lg:col-span-5">
      <div class="relative mx-auto w-full max-w-sm animate-floaty">
        <div class="relative mx-auto aspect-square w-56 sm:w-64">
          <svg viewBox="0 0 200 200" class="absolute inset-0 h-full w-full animate-spinSlow" aria-hidden="true">
            <defs>
              <path id="badge-circ" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0" />
            </defs>
            <text class="font-mono2" fill="rgba(241,241,239,.55)" font-size="8.5" letter-spacing="4.4">
              <textPath href="#badge-circ" startOffset="0">
                NICOLA CAFE · ERBIL · PREMIUM COFFEE · SINCE 1779 · PORTUGUESE STYLE ·
              </textPath>
            </text>
          </svg>
          <div class="absolute inset-8 overflow-hidden rounded-full ring-1 ring-amber/50">
            <img
              src={profile}
              alt="Nicola Cafe brand mark"
              width="160"
              height="160"
              class="h-full w-full object-cover"
              decoding="async"
            />
          </div>
        </div>

        <div class="glass mt-4 rounded-2xl p-4 text-center">
          <div class="flex items-center justify-center gap-2" data-status-wrap>
            <span class="h-2 w-2 rounded-full bg-[#7ee0a1] animate-blip" data-status-dot></span>
            <span class="font-mono2 text-[11px] uppercase tracking-[.22em] text-bone data-status" data-status>Checking hours…</span>
          </div>
          <p class="mt-2 font-mono2 text-[11px] tracking-wide text-bone/55" data-status-sub>
            Daily 8:30 AM – 12:30 AM
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- scroll cue -->
  <div class="absolute inset-x-0 bottom-6 hidden justify-center sm:flex" aria-hidden="true">
    <div class="flex items-center gap-3 font-mono2 text-[10px] uppercase tracking-[.3em] text-bone/45">
      Scroll
      <span class="block h-8 w-px bg-gradient-to-b from-amber to-transparent"></span>
    </div>
  </div>
</section>

<script>
  import { initHeroScene } from '../scripts/webgl.js';
  const canvas = document.getElementById('hero-canvas');
  if (canvas instanceof HTMLCanvasElement) initHeroScene(canvas);
</script>